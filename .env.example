# LUMIÈRE STUDIO CONFIGURATION

# GEMINI_API_KEY: Optional for Gemini AI features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE CONFIGURATION (Recommended for Database & Auth)
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key-here"

# Optional: Supabase Service Role Key (Only needed for backend server administrative bypass)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# FRONTEND CONFIGURATION
VITE_APP_NAME="LUMIÈRE Studio"
VITE_ADMIN_EMAIL="guptaashwini511@gmail.com"
VITE_OWNER_NAME="Ashwini"
VITE_OWNER_EMAIL="guptaashwini511@gmail.com"
VITE_OWNER_PASSWORD="owner1234"
VITE_API_URL="http://localhost:5000"

# EMAILJS: Required for sending order confirmation emails.
# Sign up free at https://www.emailjs.com to get these values.
# 1. Create an Email Service (Gmail/Outlook) → copy Service ID
# 2. Create an Email Template → copy Template ID
# 3. Go to Account → API Keys → copy your Public Key
VITE_EMAILJS_PUBLIC_KEY="your_public_key_here"
VITE_EMAILJS_SERVICE_ID="your_service_id_here"
VITE_EMAILJS_TEMPLATE_ID="your_template_id_here"

# BACKEND SERVER CONFIGURATION (Optional if using Supabase directly)
PORT=5000
JWT_SECRET="lumiere_super_secret_fallback_key"
CORS_ORIGIN="http://localhost:3000"
